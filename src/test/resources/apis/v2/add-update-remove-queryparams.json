{
    "id": "my-api",
    "name": "my-api",
    "gravitee": "2.0.0",
    "proxy": {
        "context_path": "/test",
        "endpoints": [
            {
                "name": "default",
                "target": "http://localhost:8080/endpoint",
                "http": {
                    "connectTimeout": 3000,
                    "readTimeout": 60000
                }
            }
        ]
    },
    "flows": [
        {
            "name": "flow-1",
            "methods": ["GET"],
            "enabled": true,
            "path-operator": {
                "path": "/",
                "operator": "STARTS_WITH"
            },
            "pre": [
                {
                    "name": "Transform Query Parameters",
                    "description": "Add, update and remove query parameters",
                    "enabled": true,
                    "policy": "transform-queryparams",
                    "configuration": {
                        "addQueryParameters": [
                            {
                                "name": "added",
                                "value": "addedValue"
                            },
                            {
                                "name": "toUpdate",
                                "value": "updatedValue"
                            }
                        ],
                        "removeQueryParameters": ["toRemove"]
                    }
                }
            ]
        }
    ]
}
